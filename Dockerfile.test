FROM python:3.12-slim

WORKDIR /app

RUN pip install uv && \
    apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN uv pip install --system --no-cache ".[dev]"

COPY src/ ./src/
COPY tests/ ./tests/

CMD ["pytest", "tests/integration/", "tests/system/", "-v", "--tb=short"]